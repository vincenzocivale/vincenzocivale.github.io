---
import '../styles/main.css';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'Vincenzo Civale | Portfolio',
  description = 'Machine learning researcher working on efficient and interpretable methods for biomedical data.',
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#20232A" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />

    <link rel="icon" href="/favicon.ico" sizes="any" />

    <title>{title}</title>
  </head>
  <body>
    <slot />
  </body>
</html>
