---
import { experiences } from '../data/experiences';
import '../styles/Experiences.css';
---

<section id="experience" class="experiences-section">
  <h2 class="experiences-heading">
    <span class="experiences-number">03.</span> Experience and education
  </h2>

  <ol class="experiences-list">
    {
      experiences.map((experience) => (
        <li class="experience-row">
          <p class="job-duration">{experience.duration}</p>
          <div>
            <h3 class="job-title">
              {experience.title}{' '}
              <span class="company-name">@ {experience.company}</span>
            </h3>
            {experience.details.length > 0 && (
              <ul class="job-details">
                {experience.details.map((detail) => (
                  <li>{detail}</li>
                ))}
              </ul>
            )}
          </div>
        </li>
      ))
    }
  </ol>
</section>
