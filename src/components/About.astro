---
import Experiences from './Experiences.astro';
import '../styles/About.css';
---

<section id="about" class="about-section">
  <div class="inner-section">
    <h2 class="about-heading">
      <span class="about-number">02.</span> About
    </h2>
    <div class="about-content">
      <div class="about-text">
        <p>
          I am a PhD student at the University of Siena, working on machine
          learning for biomedical data. My research focuses on representation
          learning and multimodal methods across bioimaging and omics, with an
          emphasis on models that are efficient, interpretable, and reliable.
        </p>
        <p>
          I enjoy working at the boundary between research and engineering:
          understanding why a model works, building the infrastructure needed to
          evaluate it properly, and turning promising ideas into reproducible
          systems.
        </p>
      </div>
      <div class="about-image-container">
        <img
          src="/assets/images/cv_profile.jpg"
          alt="Vincenzo Yuto Civale"
          class="profile-image"
          loading="lazy"
        />
      </div>
    </div>

    <Experiences />
  </div>
</section>
