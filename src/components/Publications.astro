---
import { publications } from '../data/publications';
import '../styles/Publications.css';

// Each title is cut around its keyword, so that the keyword can be highlighted.
const rows = publications.map((publication) => {
  const at = publication.title.indexOf(publication.keyword);
  if (at < 0) {
    throw new Error(
      `The keyword "${publication.keyword}" is not in the title "${publication.title}"`,
    );
  }
  return {
    ...publication,
    before: publication.title.slice(0, at),
    after: publication.title.slice(at + publication.keyword.length),
  };
});
---

<section id="publications" class="publications-section">
  <h2 class="publications-heading">
    <span class="publications-number">01.</span> Publications
  </h2>

  <div class="publications-list">
    {
      rows.map((row) => (
        <article class="publication-row">
          <div class="publication-year">{row.year}</div>

          <div class="publication-main">
            <h3 class="publication-title">
              {row.before}
              <mark>{row.keyword}</mark>
              {row.after}
            </h3>

            <p class="publication-authors">
              {row.authors.map((author, index) => (
                <>
                  {index > 0 && ', '}
                  <span
                    class={author.self ? 'publication-author-self' : undefined}
                  >
                    {author.name}
                  </span>
                </>
              ))}
            </p>

            <p class="publication-venue">
              <span class="publication-venue-name">{row.venue}</span>
              {row.venueDetail && ` · ${row.venueDetail}`}
            </p>

            {row.summary && <p class="publication-summary">{row.summary}</p>}
          </div>

          <div class="publication-links" aria-label={`Links for ${row.title}`}>
            {row.links.map((link) => (
              <a href={link.url} target="_blank" rel="noopener noreferrer">
                {link.label} <span aria-hidden="true">↗</span>
              </a>
            ))}
          </div>
        </article>
      ))
    }
  </div>

  <div class="publications-footer">
    <a
      href="https://scholar.google.com/citations?user=a6eFtBoAAAAJ&hl=en"
      target="_blank"
      rel="noopener noreferrer"
    >
      Full list on Google Scholar <span aria-hidden="true">↗</span>
    </a>
  </div>
</section>
