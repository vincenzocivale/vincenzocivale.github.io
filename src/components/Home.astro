---
import '../styles/Home.css';

// The first line of the hero types through these, one at a time.
const fields = ['Bio-Imaging', 'Genomics', 'Single Cell', 'Methylation'];
---

<section id="home" class="home-section">
  <div class="hero-text">
    <p class="intro">
      Machine learning × <span data-rotate={JSON.stringify(fields)}
        >{fields.join(' · ')}</span
      >
    </p>
    <h1 class="name">Vincenzo Yuto Civale</h1>
    <h2 class="title">Machine Learning Researcher</h2>
    <p class="description">
      PhD researcher studying what foundation models learn about biology, across
      DNA, single-cell and histopathology data, and how to make them efficient
      enough to use. My latest paper, on DNA foundation models, appears at{' '}
      <a href="#publications">NeurIPS 2026</a>.
    </p>
    <div class="hero-actions">
      <a href="#publications" class="contact-button">View publications</a>
      <a href="#contact" class="hero-secondary">
        Get in touch <span aria-hidden="true">→</span>
      </a>
    </div>
  </div>
  <div class="dna-background-svg">
    <canvas data-dna aria-hidden="true"></canvas>
    <noscript><img src="/assets/images/dna.svg" alt="" /></noscript>
  </div>
</section>

<script>
  const still = matchMedia('(prefers-reduced-motion: reduce)').matches;

  // ---- First line: type and delete the fields in turn. Without motion the full list stays.
  const word = document.querySelector<HTMLElement>('[data-rotate]');

  if (word && !still) {
    const words: string[] = JSON.parse(word.dataset.rotate ?? '[]');
    let index = 0;
    let length = words[0].length;
    let step = -1;

    const tick = () => {
      length += step;
      word.textContent = words[index].slice(0, length);

      let delay = step < 0 ? 45 : 90;
      if (length === 0) {
        index = (index + 1) % words.length;
        step = 1;
      } else if (length === words[index].length) {
        step = -1;
        delay = 1800;
      }
      setTimeout(tick, delay);
    };

    word.textContent = words[0];
    setTimeout(tick, 2500);
  }

  // ---- DNA: the dots of dna.svg, given a depth by scripts/dna_points.py, turning about the helix axis.
  const TURN_SECONDS = 24;
  const DOT = 7; // numbers per dot: axis x, axis y, across, depth, half x, half y, rung phase
  const POINT = 5; // numbers per strand point: axis x, axis y, across, depth, colour mix
  const canvas = document.querySelector<HTMLCanvasElement>('[data-dna]');
  const context = canvas?.getContext('2d');

  if (canvas && context) {
    let model: typeof import('../data/dna-points.json') | undefined;
    let frame = 0;
    let drawnWidth = 0;
    let depth = new Float32Array(0);
    let x = new Float32Array(0);
    let y = new Float32Array(0);
    let order = new Uint16Array(0);
    let colours: string[] = [];

    const draw = (now: number) => {
      frame = requestAnimationFrame(draw);
      const width = Math.round(
        canvas.clientWidth * Math.min(devicePixelRatio, 2),
      );
      if (!model || !width || (still && width === drawnWidth)) return;
      if (width !== drawnWidth) {
        canvas.width = canvas.height = drawnWidth = width;
      }

      const { size, radius, across, dots, strand } = model;
      const dotCount = dots.length / DOT;
      const pointCount = strand.length / POINT;
      const scale = width / size;
      const centre = width / 2;
      const angle = still ? 0 : (now / 1000 / TURN_SECONDS) * 2 * Math.PI;
      const cos = Math.cos(angle);
      const sin = Math.sin(angle);

      // Turn every dot and strand point about the axis, then paint from the back to the front.
      const place = (source: (number | null)[], at: number, slot: number) => {
        const offset = source[at + 2]!;
        const deep = source[at + 3]!;
        const turned = offset * cos - deep * sin;
        x[slot] = centre + scale * (source[at]! + turned * across[0]);
        y[slot] = centre + scale * (source[at + 1]! + turned * across[1]);
        depth[slot] = offset * sin + deep * cos;
      };
      for (let i = 0; i < dotCount; i++) place(dots, i * DOT, i);
      for (let j = 0; j < pointCount; j++) {
        place(strand, j * POINT, dotCount + j);
      }
      order.sort((a, b) => depth[a] - depth[b]);

      context.clearRect(0, 0, width, width);
      context.fillStyle = context.strokeStyle = '#5980de';
      context.lineCap = 'round';

      for (const item of order) {
        const near = Math.min(
          1,
          Math.max(0, (depth[item] + radius) / (2 * radius)),
        );

        if (item >= dotCount) {
          // A piece of the coloured strand, from this point to the next one.
          if (item === dotCount + pointCount - 1) continue;
          context.globalAlpha = 0.45 + 0.55 * near;
          context.strokeStyle = colours[item - dotCount];
          context.lineWidth = scale * 6 * (0.75 + 0.4 * near);
          context.beginPath();
          context.moveTo(x[item], y[item]);
          context.lineTo(x[item + 1], y[item + 1]);
          context.stroke();
          context.strokeStyle = '#5980de';
          continue;
        }

        // A dumbbell: two dots and the thin line between them. A rung seen end-on fades.
        const at = item * DOT;
        const phase = dots[at + 6];
        const facing =
          phase === null ? 1 : 0.15 + 0.85 * Math.abs(Math.cos(phase + angle));
        const alpha = (0.35 + 0.65 * near) * facing;
        const halfX = scale * dots[at + 4]! * (0.85 + 0.3 * near);
        const halfY = scale * dots[at + 5]! * (0.85 + 0.3 * near);
        const dot = scale * 2.3 * (0.8 + 0.45 * near);

        context.globalAlpha = alpha / 2;
        context.lineWidth = scale * 0.6;
        context.beginPath();
        context.moveTo(x[item] - halfX, y[item] - halfY);
        context.lineTo(x[item] + halfX, y[item] + halfY);
        context.stroke();

        context.globalAlpha = alpha;
        context.beginPath();
        context.arc(x[item] - halfX, y[item] - halfY, dot, 0, 2 * Math.PI);
        context.arc(x[item] + halfX, y[item] + halfY, dot, 0, 2 * Math.PI);
        context.fill();
      }
    };

    // Runs only while the helix is on screen; where CSS hides it, the points are never downloaded.
    let visible = false;

    new IntersectionObserver(async ([entry]) => {
      cancelAnimationFrame(frame);
      visible = entry.isIntersecting;
      if (!visible) return;

      if (!model) {
        model = (await import('../data/dna-points.json')).default;
        const count = model.dots.length / DOT + model.strand.length / POINT;
        depth = new Float32Array(count);
        x = new Float32Array(count);
        y = new Float32Array(count);
        order = Uint16Array.from({ length: count }, (_, i) => i);
        // The strand runs from gold to blue, as in the drawing.
        colours = Array.from(
          { length: model.strand.length / POINT },
          (_, j) => {
            const mix = model!.strand[j * POINT + 4];
            return `rgb(${255 - 255 * mix} ${212 - 98 * mix} ${62 + 165 * mix})`;
          },
        );
      }
      if (!visible) return; // scrolled away while the points were loading
      drawnWidth = 0; // forces a repaint when a still helix comes back on screen
      frame = requestAnimationFrame(draw);
    }).observe(canvas);
  }
</script>
